# MariaDB connection
DB_HOST=db
DB_PORT=3306
DB_NAME=bf2stats
DB_USER=bf2_sync
DB_PASSWORD=CHANGE_ME

# PRMasterServer SQLite database
SQLITE_PATH=/data/LoginDatabase.db3

# Synchronization
SYNC_INTERVAL=1

# true  = check only, do not insert records
# false = insert missing player records
DRY_RUN=true
