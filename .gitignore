# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Local FRP configurations
frpc.toml
frps.toml
!frpc.toml.example
!frps.toml.example

# Generated game server configurations
docker_generated.json

# Runtime data
**/logs/
**/profile/
**/workshop/
**/addons/
**/backups/

# Temporary files
*.tmp
*.bak
*.swp

# Active FRP proxy configurations
infra/frp/confd/*.toml

# Game server persistent data
games/*/data/

# Python runtime files
__pycache__/
*.pyc

# Battlefield 2 runtime configuration and dependencies
/games/battlefield-2/config/bf2/BF2StatisticsConfig.py
/games/battlefield-2/sources/
